From 27085191c0d6dad823bdeb9e3d0b4fef148fc93f Mon Sep 17 00:00:00 2001
From: Het <hetzel30@gmail.com>
Date: Fri, 9 Oct 2026 09:31:12 -0500
Subject: [PATCH 1/2] port: build and run natively on macOS (Apple Silicon /
 ARM64)

- src/portable_rng.h: portable shims for the x86 RDRAND intrinsics
  (arc4random_buf on Darwin/BSD, std::random_device elsewhere); x86
  targets keep the real <immintrin.h> intrinsics.
- Replace non-MSVC <immintrin.h> includes with portable_rng.h in
  K12AndKeyUtil.h, network.h, Qiner.cpp and the tools.
- CMakeLists: gate -mrdrnd -mbmi to x86 targets only.
- Qiner: build the ~512 MB random2 pool once in main() and share it
  read-only across all mining threads (setPool), instead of one pool
  per thread (N x 512 MB). The pool is a pure function of the mining
  seed, so this is semantics-preserving; essential on unified memory.
---
 CMakeLists.txt                     |  8 +++-
 src/K12AndKeyUtil.h                |  2 +-
 src/Qiner.cpp                      | 28 +++++++++++++-
 src/network.h                      |  2 +-
 src/portable_rng.h                 | 61 ++++++++++++++++++++++++++++++
 tools/bpp9000_synth.h              |  2 +-
 tools/broadcastAntSolution.cpp     |  2 +-
 tools/broadcastMessageSolution.cpp |  2 +-
 8 files changed, 98 insertions(+), 9 deletions(-)
 create mode 100644 src/portable_rng.h

diff --git a/CMakeLists.txt b/CMakeLists.txt
index baca214..73219e7 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -11,8 +11,12 @@ endif()
 
 # Additional cmake flags
 if(CMAKE_CXX_COMPILER_ID MATCHES "Clang" OR CMAKE_CXX_COMPILER_ID MATCHES "GNU")
-    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -mrdrnd -mbmi")
-    set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -mrdrnd -mbmi")
+    # RDRAND/BMI are x86-only. On other targets (e.g. Apple Silicon / ARM64)
+    # the portable shims in src/portable_rng.h replace the intrinsics.
+    if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|i386|i686)$")
+        set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -mrdrnd -mbmi")
+        set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -mrdrnd -mbmi")
+    endif()
 elseif(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
 else()
     message(FATAL "Unsupported compiler.")
