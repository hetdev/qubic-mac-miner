index e95d546..a6d5b87 100644
--- a/src/Qiner.cpp
+++ b/src/Qiner.cpp
@@ -14,7 +14,7 @@
 
 #else
 #include <signal.h>
-#include <immintrin.h>
+#include "portable_rng.h"
 #include <arpa/inet.h>
 #include <sys/socket.h>
 #include <unistd.h>
@@ -101,6 +101,12 @@ static std::atomic<char> state(0);
 
 static unsigned char computorPublicKey[32];
 static unsigned char randomSeed[32];
+// One random2 pool shared read-only by every mining thread. Each Bpp9000Miner used to own a
+// ~512 MB pool, so N threads cost N x 512 MB - prohibitive on machines with unified memory
+// (Apple Silicon). The pool is a pure function of the mining seed, so every thread previously
+// generated an identical copy anyway; sharing one is semantics-preserving (the same pattern the
+// AntMiner uses). Populated in main() before the mining threads start.
+static std::vector<unsigned char> sharedRandom2Pool;
 // Path to the bpp9000 task file (input/output trit data); overridable via CLI.
 static const char* taskFilePath = "task_bpp9000.bin";
 static std::atomic<long long> numberOfMiningIterations(0);
@@ -188,7 +194,19 @@ int miningThreadProc()
 {
     std::unique_ptr<Bpp9000Miner> bpp9000Miner(new Bpp9000Miner());
     // bpp9000 loads the topology (placement/wiring) and the data from the unified task file.
-    if (!bpp9000Miner->initialize(randomSeed, taskFilePath))
+    if (!sharedRandom2Pool.empty())
+    {
+        // Shared-pool path: skip the per-thread ~512 MB pool; wire the miner to the pool built
+        // once in main() and replicate the remaining work of initialize().
+        bpp9000Miner->setPool(sharedRandom2Pool.data());
+        bpp9000Miner->deriveControlOutput(randomSeed);
+        if (!bpp9000Miner->loadTaskData(taskFilePath))
+        {
+            printf("Failed to load task file '%s' for the bpp9000 miner.\n", taskFilePath);
+            return -1;
+        }
+    }
+    else if (!bpp9000Miner->initialize(randomSeed, taskFilePath))
     {
         printf("Failed to load task file '%s' for the bpp9000 miner.\n", taskFilePath);
         return -1;
@@ -401,6 +419,12 @@ int main(int argc, char* argv[])
 
             unsigned int numberOfThreads = atoi(argv[6]);
             printf("%d threads are used.\n", numberOfThreads);
+
+            // Build the shared random2 pool once (~512 MB) instead of once per thread.
+            printf("Building the shared random2 pool (~512 MB)...\n");
+            sharedRandom2Pool.resize(POOL_VEC_PADDING_SIZE);
+            generateRandom2Pool(randomSeed, sharedRandom2Pool.data());
+
             miningThreads.reserve(numberOfThreads);
             for (unsigned int i = numberOfThreads; i-- > 0; )
             {
