+#if !defined(_MSC_VER) && !defined(__x86_64__) && !defined(__i386__)
+// Portable 32-byte vector stand-in for the AVX __m256i type. In the vendored FourQ code below,
+// __m256i is only ever used as a 32-byte copy helper over f2elm_t (2x2 u64) fields, whose natural
+// alignment is 8 bytes; the aligned(8) attribute preserves exactly that, and clang lowers the
+// copies to NEON q-register loads/stores on ARM64.
+typedef unsigned long long __m256i __attribute__((vector_size(32), aligned(8)));
+#endif
