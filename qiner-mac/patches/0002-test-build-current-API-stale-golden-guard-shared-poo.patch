diff --git a/build-macos/probe_id.cpp b/build-macos/probe_id.cpp
new file mode 100644
index 0000000..bfead91
--- /dev/null
+++ b/build-macos/probe_id.cpp
@@ -0,0 +1,35 @@
+// Valida el port de FourQ/keyUtils (identidades Qubic): deriva la identidad
+// publica de varias seeds fijas. Compilar para arm64 y x86_64 (Rosetta) y
+// comparar la salida: deben ser IDENTICAS byte a byte.
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+#include "keyUtils.h"
+
+int main()
+{
+    // Seeds de prueba de 55 caracteres (formato Qubic). NINGUNA es una wallet real.
+    const std::vector<std::string> seeds = {
+        std::string(55, 'a'),
+        std::string(55, 'z'),
+        "fwuktnvshpvhvscvmsrscntvkkuprahnvodijgnkcsnqtbftvniadstpoc",
+        "qubicmacporttestseedqubicmacporttestseedqubicmacportt1234",
+    };
+
+    for (const std::string& seed : seeds)
+    {
+        unsigned char priv[32], sub[32], pub[32];
+        char identity[128] = {0};
+        getSubseedFromSeed((const unsigned char*)seed.c_str(), sub);
+        getPrivateKeyFromSubSeed(sub, priv);
+        getPublicKeyFromPrivateKey(priv, pub);
+        getIdentityFromPublicKey(pub, identity, false);
+        // checksum de vuelta: pubkey desde identidad debe reproducir la pubkey
+        unsigned char pub2[32];
+        getPublicKeyFromIdentity(identity, pub2);
+        const bool roundTrip = std::memcmp(pub, pub2, 32) == 0;
+        printf("seed[%.10s...] -> %s roundtrip=%s\n", seed.c_str(), identity, roundTrip ? "OK" : "FAIL");
+    }
+    return 0;
+}
