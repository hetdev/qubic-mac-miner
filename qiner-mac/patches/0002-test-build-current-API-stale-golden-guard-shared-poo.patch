+// --- shared-pool equivalence (this port) ---------------------------------------------------------
+// The macOS port makes Qiner build ONE random2 pool and share it read-only across all mining
+// threads via setPool(), instead of one identical ~512 MB pool per thread. The pool is a pure
+// function of the mining seed, so both layouts must produce identical Ratings. This pins that
+// equivalence: one fixed (pubkey, nonce) scored through the owned-pool path (initialize) and
+// through the shared-pool path (setPool + deriveControlOutput + loadTaskData) must agree exactly.
+
+TEST_CASE("bpp9000 shared pool vs owned pool equivalence", "[bpp9000AntColony]")
+{
+    const char* SEED_HEX = "8b12add89bc264e01038b61b784e0778a03cd3025e1faeedda6598f197ceccc0";
+    const char* PUB_HEX = "039cc1f1560aa96daa994a2b296f22d7f2fc9503ce95321d0b8193079e5f93dc";
+    const char* NONCE_HEX = "bee1e55fc2c967601827dd80f09a6b0a47ceab37b920b57efbd23c8fdc49e38f";
+    const std::string taskPath = dataPath("bpp9000.task");
+
+    unsigned char seed[32], pub[32], nonce[32];
+    REQUIRE(parseHex32(SEED_HEX, seed));
+    REQUIRE(parseHex32(PUB_HEX, pub));
+    REQUIRE(parseHex32(NONCE_HEX, nonce));
+
+    std::vector<unsigned char> sharedPool(POOL_VEC_PADDING_SIZE);
+    generateRandom2Pool(seed, sharedPool.data());
+
+    std::atomic<bool> failed(false);
+    score_bpp9000::Rating ownedResult;
+    score_bpp9000::Rating sharedResult;
+
+    const auto owned = [&]()
+    {
+        std::unique_ptr<ProdMiner> miner(new ProdMiner());
+        if (!miner->initialize(seed, taskPath.c_str()))
+        {
+            failed.store(true);
+            return;
+        }
+        ownedResult = miner->computeScore(pub, nonce);
+    };
+    const auto shared = [&]()
+    {
+        std::unique_ptr<ProdMiner> miner(new ProdMiner());
+        miner->setPool(sharedPool.data());
+        miner->deriveControlOutput(seed);
+        if (!miner->loadTaskData(taskPath.c_str()))
+        {
+            failed.store(true);
+            return;
+        }
+        sharedResult = miner->computeScore(pub, nonce);
+    };
+
+    std::thread t1(owned);
+    std::thread t2(shared);
+    t1.join();
+    t2.join();
+
+    REQUIRE_FALSE(failed.load());
+    INFO("owned:  error=" << ownedResult.error << " shift=" << ownedResult.shift
+         << " | shared: error=" << sharedResult.error << " shift=" << sharedResult.shift);
+    CHECK(ownedResult.error == sharedResult.error);
+    CHECK(ownedResult.shift == sharedResult.shift);
+}
