diff --git a/build-macos/probe_gt.cpp b/build-macos/probe_gt.cpp
new file mode 100644
index 0000000..138653a
--- /dev/null
+++ b/build-macos/probe_gt.cpp
@@ -0,0 +1,150 @@
+// Empirical probe: do the golden CSVs in test/data match the CURRENT scorer on this machine?
+// Tests, in parallel (each full walk is ~2-3 min scalar):
+//   A. solo  : computeScore(pub, nonce)                     vs gt_production.csv row 0     (expect 4254)
+//   B. ant/v1: root = deriveRootANN(pub)  (current tool)    vs gt_ant_production.csv row 0 (expect 4881)
+//   C. ant/v2: root = deriveRootANN(seed) (stale test code) vs the same golden             (expect 4881)
+//   D. instant: deriveRootANN root digests vs the hardcoded ROOT_DIGEST_HEX vectors.
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <thread>
+#include <vector>
+#include <memory>
+
+#include "score_bpp9000.h"
+
+using ProdMiner = score_bpp9000::Miner<
+    score_bpp9000::NUMBER_OF_INPUT_NEURONS,
+    score_bpp9000::NUMBER_OF_OUTPUT_NEURONS,
+    score_bpp9000::SEQUENCE_LENGTH,
+    score_bpp9000::WINDOW_WIDTH,
+    score_bpp9000::MAX_NUMBER_OF_TICKS,
+    score_bpp9000::NUMBER_OF_NEIGHBORS,
+    score_bpp9000::POPULATION_THRESHOLD,
+    score_bpp9000::NUMBER_OF_MUTATIONS,
+    score_bpp9000::SOLUTION_THRESHOLD,
+    score_bpp9000::SHIFT_CAP>;
+
+static bool parseHex32(const std::string& s, unsigned char* out)
+{
+    std::string t;
+    for (char c : s) if (c != ' ' && c != '\t' && c != '\r' && c != '\n') t.push_back(c);
+    if (t.size() != 64) return false;
+    for (int i = 0; i < 32; ++i)
+    {
+        int hi = 0, lo = 0;
+        auto hv = [](char c) -> int {
+            if (c >= '0' && c <= '9') return c - '0';
+            if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+            if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+            return -1; };
+        hi = hv(t[2 * i]); lo = hv(t[2 * i + 1]);
+        if (hi < 0 || lo < 0) return false;
+        out[i] = (unsigned char)((hi << 4) | lo);
+    }
+    return true;
+}
+
+int main()
+{
+    const std::string taskPath = "test/data/bpp9000.task";
+    const std::string SEED_HEX = "8b12add89bc264e01038b61b784e0778a03cd3025e1faeedda6598f197ceccc0";
+    const std::string SOLO_PUB = "039cc1f1560aa96daa994a2b296f22d7f2fc9503ce95321d0b8193079e5f93dc";
+    const std::string SOLO_NONCE = "bee1e55fc2c967601827dd80f09a6b0a47ceab37b920b57efbd23c8fdc49e38f";
+    const unsigned int SOLO_EXPECTED = 4254;
+    const std::string ANT_PUB = "92435ad4eef3146ecb44cfa4a23f06f7fdfed617db0232eb2e128cdf4844b214";
+    const std::string ANT_NONCE = "0108397d154a909ade59b54db4e3fccc789070e5cfae563c2c5cb4c509352e7d";
+    const std::string ANT_ANCHOR = "68f1f0e543021dcf9a0baefa54effc954555d8bc08ccb54033294e48cb86f0fa";
+    const unsigned int ANT_EXPECTED = 4881;
+    const char* ROOT_DIGEST_HEX[3] = {
+        "6f782f3a0b53902e8a9b8d7eaad3d134ab8ef4c0d9d88dfb820144c2ce230100",
+        "a5a63aeca47c07a083759e5ffb98d10bddad204ee3292315b4ba772c0bb6df27",
+        "371dc2af0094a0ea99984edec4ea65c4f743d3150243f4c0857c651e7e021a64"};
+    const char* ROOT_PUB_HEX[3] = {
+        "039cc1f1560aa96daa994a2b296f22d7f2fc9503ce95321d0b8193079e5f93dc",
+        "d4aaeaf020007d1349590d77e2f779ad48f9a6cf720d04ca6a65fbbad81dc050",
+        "2cfd43630593e07902ff52948ce387aaf0e2bb0e11952f8a0c91a33672203bcc"};
+
+    unsigned char seed[32];
+    if (!parseHex32(SEED_HEX, seed)) { printf("bad seed hex\n"); return 1; }
+
+    // One shared pool for every probe (the shared-pool pattern this port adds to Qiner).
+    std::vector<unsigned char> pool(POOL_VEC_PADDING_SIZE);
+    generateRandom2Pool(seed, pool.data());
+    printf("pool built (%.0f MB)\n", pool.size() / 1048576.0);
+
+    // D. instant: root digests from the current deriveRootANN(pub).
+    {
+        ProdMiner m;
+        m.setPool(pool.data());
+        m.deriveControlOutput(seed);
+        if (!m.loadTaskData(taskPath.c_str())) { printf("task load FAILED\n"); return 1; }
+        printf("task loaded OK\n");
+        for (int i = 0; i < 3; ++i)
+        {
+            unsigned char pub[32], want[32];
+            ProdMiner::ANN root;
+            std::memset(&root, 0, sizeof(root));
+            parseHex32(ROOT_PUB_HEX[i], pub);
+            parseHex32(ROOT_DIGEST_HEX[i], want);
+            m.deriveRootANN(pub, root);
+            unsigned char digest[32];
+            KangarooTwelve(root.lut, (unsigned int)sizeof(root.lut), digest, 32);
+            printf("[D] root digest[%d]: %s\n", i, std::memcmp(digest, want, 32) == 0 ? "MATCH" : "MISMATCH");
+        }
+    }
+
+    unsigned int soloScore = 0xFFFFFFFF, antPubScore = 0xFFFFFFFF, antSeedScore = 0xFFFFFFFF;
+
+    const auto solo = [&]()
+    {
+        ProdMiner m; m.setPool(pool.data()); m.deriveControlOutput(seed);
+        if (!m.loadTaskData(taskPath.c_str())) return;
+        unsigned char pub[32], nonce[32];
+        parseHex32(SOLO_PUB, pub); parseHex32(SOLO_NONCE, nonce);
+        const score_bpp9000::Rating r = m.computeScore(pub, nonce);
+        soloScore = r.error;
+        printf("[A] solo computeScore: got %u, expected %u -> %s\n", soloScore, SOLO_EXPECTED,
+               soloScore == SOLO_EXPECTED ? "MATCH" : "MISMATCH");
+    };
+
+    const auto antPub = [&]()
+    {
+        ProdMiner m; m.setPool(pool.data()); m.deriveControlOutput(seed);
+        if (!m.loadTaskData(taskPath.c_str())) return;
+        unsigned char pub[32], nonce[32], anchor[32];
+        parseHex32(ANT_PUB, pub); parseHex32(ANT_NONCE, nonce); parseHex32(ANT_ANCHOR, anchor);
+        ProdMiner::ANN root; std::memset(&root, 0, sizeof(root));
+        m.deriveRootANN(pub, root);
+        const score_bpp9000::Rating r = m.computeScoreFromParent(root, 0, pub, nonce, anchor);
+        antPubScore = r.error;
+        printf("[B] ant root=deriveRootANN(pub): got %u, expected %u -> %s\n", antPubScore, ANT_EXPECTED,
+               antPubScore == ANT_EXPECTED ? "MATCH" : "MISMATCH");
+    };
+
+    const auto antSeed = [&]()
+    {
+        ProdMiner m; m.setPool(pool.data()); m.deriveControlOutput(seed);
+        if (!m.loadTaskData(taskPath.c_str())) return;
+        unsigned char pub[32], nonce[32], anchor[32];
+        parseHex32(ANT_PUB, pub); parseHex32(ANT_NONCE, nonce); parseHex32(ANT_ANCHOR, anchor);
+        ProdMiner::ANN root; std::memset(&root, 0, sizeof(root));
+        m.deriveRootANN(seed, root);
+        const score_bpp9000::Rating r = m.computeScoreFromParent(root, 0, pub, nonce, anchor);
+        antSeedScore = r.error;
+        printf("[C] ant root=deriveRootANN(seed): got %u, expected %u -> %s\n", antSeedScore, ANT_EXPECTED,
+               antSeedScore == ANT_EXPECTED ? "MATCH" : "MISMATCH");
+    };
+
+    std::vector<std::thread> ts;
+    ts.emplace_back(solo);
+    ts.emplace_back(antPub);
+    ts.emplace_back(antSeed);
+    for (auto& t : ts) t.join();
+
+    printf("\nsummary: A(solo)=%s B(ant,pub)=%s C(ant,seed)=%s\n",
+           soloScore == SOLO_EXPECTED ? "MATCH" : (soloScore == 0xFFFFFFFF ? "n/a" : "MISMATCH"),
+           antPubScore == ANT_EXPECTED ? "MATCH" : (antPubScore == 0xFFFFFFFF ? "n/a" : "MISMATCH"),
+           antSeedScore == ANT_EXPECTED ? "MATCH" : (antSeedScore == 0xFFFFFFFF ? "n/a" : "MISMATCH"));
+    return 0;
+}
