# ============================================================
# Qubic Mac Miner - settings
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER put your wallet seed here. Only the PUBLIC address
# (60 letters A-Z) or the panel AccessToken.
# ============================================================

# ---- Pool to use --------------------------------------------------
# qli    = QLI / platform.qubic.li (primary; needs a token or a
#           registerless address)
# jetski = jetskipool.ai (alternative, PPLNS/Solo, no token)
QUBIC_POOL=qli

# Your Qubic public address (the one that receives payouts).
# Create it at https://wallet.qubic.org and keep the seed OFFLINE.
QUBIC_ADDRESS=

# This Mac's alias on the pool dashboard (optional;
# empty = uses the machine name)
QUBIC_ALIAS=mac-miner

# Number of training threads.
# Recommended on Apple Silicon: number of P-cores - 1
#   sysctl -n hw.perflevel0.logicalcpu
# Empty = auto (P-cores - 1).
QUBIC_THREADS=

# On QLI:   true = PPS (pay per iteration, recommended on Macs)
#           false = solo (you only earn when your worker finds a solution)
# On jetski: true = PPLNS, false = solo
QUBIC_PPS=true

# JWT access token from the platform.qubic.li panel (QLI only;
# optional if you just use the public address - registerless mode).
QUBIC_TOKEN=

# QLI pool WSS endpoint (the official one by default; change it only if you
# use a 100% QLI-protocol-compatible pool).
#QUBIC_POOL_URL=wss://wps.qubic.li/ws

# Do not start the miner at login while on battery (install-service honors it)
#MINER_ON_BATTERY=skip
